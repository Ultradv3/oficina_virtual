# Agent Office — configuración de entorno
# Copia este archivo a .env y ajústalo. No subas .env al repositorio.

# Token requerido para /api y /api/events. Si está vacío, la API queda abierta.
# En despliegues expuestos, define siempre un token largo y aleatorio.
AGENT_OFFICE_TOKEN=

# Conexión OpenCode (servidor sin TUI).
OPENCODE_BASE_URL=http://127.0.0.1:4096
# Directorio de trabajo que se pasa a la API de OpenCode (?directory=...).
OPENCODE_DIRECTORY=
# Modelo por defecto para las tareas creadas desde Agent Office (provider/modelo).
# Ejemplo: deepseek/deepseek-flash. Vacío = usa el default del servidor OpenCode.
OPENCODE_MODEL=
# Credenciales básicas si OPENCODE_SERVER_PASSWORD está definido en el servidor.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# Ruta de la base SQLite (por defecto ./data/agent-office.db).
AGENT_OFFICE_DB=

# Alternativa: varias conexiones declaradas como JSON. Si se define, ignora
# OPENCODE_BASE_URL y permite mezclar adaptadores (p. ej. dos servidores OpenCode).
# AGENT_OFFICE_CONNECTIONS=[{"id":"atlas","name":"Atlas","adapter":"opencode","config":{"baseUrl":"http://127.0.0.1:4096","directory":"/workspace","model":"deepseek/deepseek-flash"}}]

# Docker Compose
OPENCODE_WORKSPACE=.
